    "verify:native-host-smoke": "node scripts/verify-native-host-smoke.mjs",
    "benchmark:repository-scan": "node scripts/benchmark-repository-scan.mjs",
    "benchmark:prepared-traversal": "node scripts/benchmark-prepared-traversal.mjs",
    "benchmark:arcadedb-query-batch": "node scripts/benchmark-arcadedb-query-batch.mjs",
    "verify:runtime-adapters": "node scripts/verify-runtime-adapters.mjs",
    "verify:runtime-lifecycle": "node scripts/verify-runtime-invocation-lifecycle.mjs",
    "verify:provider-replacement": "node scripts/verify-provider-replacement-recovery.mjs",
    "verify:hostless-session-recovery": "node scripts/verify-hostless-session-recovery.mjs",
    "verify:workspace-host-coordination": "node --test --test-isolation=none --test-concurrency=1 test/workspace-host-coordination.test.mjs",
    "verify:workspace-host-export": "node --test --test-isolation=none --test-concurrency=1 test/workspace-host-coordination.test.mjs",
