    "verify:native-delivery": "node scripts/verify-native-artifact-delivery.mjs",
    "verify:newcomer": "node scripts/verify-newcomer-readme.mjs",
    "verify:docs": "node test/verify-documentation-localization.mjs",
    "verify:conversational-onboarding": "node scripts/verify-conversational-onboarding.mjs",
    "verify:graphdb-sync": "node scripts/verify-arcadedb-incremental-sync.mjs",
    "build:codex-marketplace": "node scripts/build-codex-marketplace.mjs",
    "verify:codex-marketplace": "node scripts/verify-codex-marketplace.mjs",
    "build:claude-marketplace": "node scripts/build-claude-marketplace.mjs",
    "verify:claude-marketplace": "node scripts/verify-claude-marketplace.mjs",
    "distribution:status": "node scripts/distribution.mjs status"
  }
