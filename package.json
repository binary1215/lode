{
  "name": "@local/lode-agent-core-plugin",
  "version": "0.3.0-beta.64",
  "private": true,
  "type": "module",
  "description": "Lode Agent Core plugin distribution",
  "homepage": "https://github.com/binary1215/lode",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-isolation=none --test-concurrency=1 test/*.test.mjs",
